# ===== Passerelle WhatsApp lwb-whmcs-wha =====
# Copiez ce fichier en ".env" puis modifiez les valeurs.

# Clé secrète partagée avec WHMCS (32+ caractères aléatoires).
# Générez-en une avec :  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=CHANGEZ_MOI_cle_secrete_tres_longue

# Adresse d'écoute. Laissez 127.0.0.1 si WHMCS est sur le même serveur.
# Mettez 0.0.0.0 seulement si WHMCS est sur une autre machine (et filtrez le port au pare-feu).
HOST=127.0.0.1
PORT=3000

# Dossier de la session WhatsApp, des désinscriptions, quotas, statuts (à sauvegarder, à protéger).
DATA_DIR=./data

# ----- Anti-bannissement -----
# Délai aléatoire entre deux messages (millisecondes).
MIN_DELAY_MS=8000
MAX_DELAY_MS=20000
# Quotas d'envois.
MAX_PER_HOUR=30
MAX_PER_DAY=150
# Contacts jamais contactés auparavant (le signal le plus surveillé par WhatsApp).
MAX_NEW_PER_DAY=20
# Rodage d'un numéro fraîchement relié : quotas réduits pendant N jours.
WARMUP_DAYS=7
WARMUP_MAX_PER_DAY=30
WARMUP_MAX_NEW_PER_DAY=10
# Marquer comme lus les messages reçus (comportement humain).
READ_INCOMING=true
# Mots-clés de désinscription / réinscription envoyés par le client.
OPTOUT_WORDS=STOP,ARRET,ARRÊT,DESABONNER,DÉSABONNER,UNSUBSCRIBE
OPTIN_WORDS=START,REPRENDRE
OPTOUT_REPLY=Vous ne recevrez plus nos notifications WhatsApp. Répondez START pour les réactiver.
OPTIN_REPLY=Notifications WhatsApp réactivées. Merci !

LOG_LEVEL=warn
